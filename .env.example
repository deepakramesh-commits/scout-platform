DATABASE_URL=postgres://postgres:postgres@localhost:54330/postgres
# Required in production; the dev server falls back to a fixed development secret.
SESSION_SECRET=
# Where uploaded video and exports are written (default: ./storage at the repo root).
STORAGE_DIR=
# Optional: Mux video (direct upload, signed playback). Leave empty to use local storage.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_KEY_PRIVATE=
# Optional: report summaries written by Claude instead of the template.
ANTHROPIC_API_KEY=
